# =====================================================================
# Folder unggahan: berisi berkas milik pengguna.
# Lapisan pengaman kedua (pertama ada di Validation MIME di helpers.php).
# =====================================================================

# Jangan pernah mengindeks isi folder.
Options -Indexes -ExecCGI

# Matikan eksekusi skip apa pun di dalam folder ini (defense-in-depth):
# walau ada berkas dengan ekstensi skrip somehow tersimpan di sini,
# Apache tidak akan menjalankannya sebagai kode.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Cegah browser menebak-nebak tipe berkas (MIME sniffing).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Tolak akses ke berkas skip apa pun (php, phtml, cgi, pl, py, sh, exe, dll).
<FilesMatch "(?i)\.(php|phtml|phar|php\d|cgi|pl|py|sh|htaccess|exe|bat|cmd|com)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>